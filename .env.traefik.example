# Copy this file to .env before running the local Traefik integration Compose.
# Docker Compose automatically reads .env for build args and runtime variables.
#
# This file is for local integration, not production deployment. Brand, contacts,
# social handles, map pin, business type and canonical origin belong to
# properties/<slug>/property.config.json — one directory per storefront.

# Which properties/<slug>/ this image serves. Required once more than one exists.
PROPERTY=your-property-slug

# Traefik routing. The Vendra proxy stack must already be running and own the
# external `traefik-public` Docker network.
DOMAIN=your-property.example
ROUTER_NAME=your-property
# Local integration uses Vendra's local certificate, so leave this empty.
CERT_RESOLVER=

# The canonical Vendra API — ONE host for every property, no /api suffix needed.
# The tenant is resolved from this storefront's origin, so the property's
# `domain` must be registered and active in Vendra.
VENDRA_API_URL=https://api.your-base-domain.example
NEXT_PUBLIC_VENDRA_API_URL=https://api.your-base-domain.example
# Hostname only, mapped to host-gateway for the local Vendra Traefik stack.
VENDRA_API_HOST=api.your-base-domain.example

# Media host. Unset, the API origin is used (it serves /storage).
# STORAGE_BASE_URL=
# NEXT_PUBLIC_STORAGE_BASE_URL=

# Canonical origin override. Unset, the property's siteUrl applies — set this
# only when a deployment serves the property on another domain (e.g. staging).
# NEXT_PUBLIC_SITE_URL=

# Contact overrides. Unset, the property config applies.
# CONTACT_MOBILE_PHONE=
# CONTACT_OFFICE_PHONE=
# CONTACT_EMAIL=
# CONTACT_HOURS_OPEN=
# CONTACT_HOURS_CLOSE=
# CONTACT_MAP_QUERY=

# Checkout delivery map provider: "osm" (default, free, key-less) or "neshan".
# Leave unset/"osm" to use OpenStreetMap + Nominatim with no keys.
NEXT_PUBLIC_MAP_PROVIDER=osm
# Neshan keys (only needed when NEXT_PUBLIC_MAP_PROVIDER=neshan). Get them free
# at https://platform.neshan.org — note they are TWO different keys:
#   - map key  : renders tiles in the browser (safe to expose).
#   - service key: reverse-geocoding REST API, kept server-side only.
NEXT_PUBLIC_NESHAN_MAP_KEY=
NESHAN_SERVICE_KEY=
# Optional Neshan base style; unset = "standard-day" in light, "standard-night"
# in dark. Other options: dreamy, neshan, standard-day, standard-night.
NEXT_PUBLIC_NESHAN_MAP_TYPE=
